# --- Local LLM (LM Studio OpenAI-compatible server; vLLM would be http://localhost:8000/v1)
LLM_MODE=live                      # live | mock (mock = deterministic template drafter, no server needed)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-vl-30b-a3b-instruct
LLM_API_KEY=lm-studio
LLM_TIMEOUT=300
LLM_MAX_TOKENS=700

# --- GPU
CUDA_VISIBLE_DEVICES=0
EMBED_MODEL=BAAI/bge-large-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-large
MIN_FREE_VRAM_GB=2.5

# --- Guardrails
MAX_DISCOUNT_PCT=20
MIN_MARGIN_PCT=35
PROPENSITY_THRESHOLD=0.25
MAX_RETRIES=2
MAX_MSGS_PER_7D=2
QUIET_HOURS_START=21
QUIET_HOURS_END=8

# --- Services
FLASK_HOST=127.0.0.1
FLASK_PORT=5055
STREAMLIT_PORT=8511
